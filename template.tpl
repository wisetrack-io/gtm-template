___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const copyFromWindow = require('copyFromWindow');
const logToConsole = require('logToConsole');
const makeInteger = require('makeInteger');
const callInWindow = require('callInWindow');

const action = data.action;

function isWiseTrackAvailable(){
  const WiseTrackSDK = copyFromWindow('WiseTrackSDK');

  if (!WiseTrackSDK || !WiseTrackSDK.WiseTrack) {
    logToConsole('WiseTrack SDK not found');
    data.gtmOnFailure();
    return false;
  }
  return true;
}

// Initialize WiseTrack SDK
function initializeWiseTrack() {
  if(!isWiseTrackAvailable()) return;

  const config = {
    appToken: data.appToken,
    appVersion: data.appVersion,
    appFrameWork: data.appFramework,
    userEnvironment: data.userEnvironment,
    startTrackerAutomatically: data.autoStart !== false,
    logLevel: data.logLevel,
    trackingWaitingTime: data.trackingWaitingTime ? makeInteger(data.trackingWaitingTime) : 0,
    customDeviceId: data.customDeviceId
  };

  callInWindow('WiseTrackSDK.WiseTrack.instance.init', config);
  data.gtmOnSuccess();
}

// Track Event
function trackEvent() {
  if(!isWiseTrackAvailable()) return;

  const eventParams = {};
  if (data.eventParameters) {
    data.eventParameters.forEach(function(row) {
      eventParams[row.key] = row.value;
    });
  }

  const eventObject = {
    type: data.eventType,
    name: data.eventName,
    params: eventParams
  };

  if (data.eventType === 'revenue') {
    eventObject.amount = data.revenueAmount;
    eventObject.currency = data.currency;
  }

  callInWindow('WiseTrackSDK.WiseTrack.instance.trackEvent', eventObject);
  data.gtmOnSuccess();
}

// Start Tracking
function startTracking(){
  if(!isWiseTrackAvailable()) return;
  
  callInWindow('WiseTrackSDK.WiseTrack.instance.startTracking');  
  data.gtmOnSuccess();
}

// Stop Tracking
function stopTracking(){
  if(!isWiseTrackAvailable()) return;
  
  callInWindow('WiseTrackSDK.WiseTrack.instance.stopTracking');
  data.gtmOnSuccess();
}

// Flush SDK
function flushSdk(){
  if(!isWiseTrackAvailable()) return;
  
  callInWindow('WiseTrackSDK.WiseTrack.instance.flush');
  data.gtmOnSuccess();
}

// Inject SDK Script
function injectPackage(url, fallbackFunction) {
  logToConsole('SDK not found, injecting script...');
  
  injectScript(
    url,
    function() {
      logToConsole('Script loaded successfully');
      executeAction();
    },
    function() {
      if (fallbackFunction) {
        fallbackFunction();
      } else {
        logToConsole('Script loading failed');
        data.gtmOnFailure();
      }
    }
  );
}

// Execute action based on selection
function executeAction() {
  switch (action){
    case 'initialize':
      initializeWiseTrack();
    break;
    case 'track-event':
      trackEvent();
    break;
    case 'initialize':
      initializeWiseTrack();
    break;
    case 'start-tracking':
      startTracking();
    break;
    case 'stop-tracking':
      stopTracking();
    break;
    case 'flush':
      flushSdk();
    break;   
  }
}

// Main execution
const existingSDK = copyFromWindow('WiseTrackSDK');

if (action === 'initialize' && !existingSDK) {
  injectPackage(
    'https://unpkg.com/wisetrack/dist/cdn/sdk.bundle.min.js',
    function() {
      injectPackage(
        'https://cdn.jsdelivr.net/npm/wisetrack/dist/cdn/sdk.bundle.min.js',
        null
      );
    }
  );
} else if (existingSDK) {
  executeAction();
} else {
  logToConsole('SDK not loaded. Please initialize first.');
  data.gtmOnFailure();
}


