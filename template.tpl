const injectScript = require('injectScript');
const copyFromWindow = require('copyFromWindow');
const logToConsole = require('logToConsole');
const makeInteger = require('makeInteger');
const makeNumber = require('makeNumber');
const callInWindow = require('callInWindow');
const createQueue = require('createQueue');

const action = data.action;

function isWiseTrackAvailable(){
  const WiseTrackSDK = copyFromWindow('WiseTrackSDK');

  if (!WiseTrackSDK || !WiseTrackSDK.WiseTrack) {
    logToConsole('WiseTrack SDK not found');
    data.gtmOnFailure();
    return false;
  }
  return true;
}

// Collect a single column of a SIMPLE_TABLE into a list of non-empty strings
function tableColumn(rows, column) {
  const values = [];
  if (!rows) return values;
  rows.forEach(function(row) {
    const value = row[column];
    if (value) values.push(value);
  });
  return values;
}

// Convert a key/value SIMPLE_TABLE into a params object
function tableToParams(rows) {
  const params = {};
  if (!rows) return params;
  rows.forEach(function(row) {
    params[row.key] = row.value;
  });
  return params;
}

// Whether the loaded SDK has the features this template relies on beyond
// SDK 2.3.2: plain-object events and string screen patterns. Both arrived with
// WTEvent.from, so its presence identifies a new enough SDK.
function sdkSupportsTemplateFeatures() {
  return typeof copyFromWindow('WiseTrackSDK.WTEvent.from') === 'function';
}

// Fail the tag when the loaded SDK predates this template
function requireLatestSdk(feature) {
  if (sdkSupportsTemplateFeatures()) return true;
  logToConsole('WiseTrack: ' + feature + ' needs the latest WiseTrack SDK. Update the SDK loaded on this page.');
  data.gtmOnFailure();
  return false;
}

// Push every deeplink the SDK receives to the dataLayer
function registerDeeplinkListener() {
  if (data.deeplinkEnabled === false || !data.pushDeeplinksToDataLayer) return;
  if (!sdkSupportsTemplateFeatures()) {
    logToConsole('WiseTrack: Pushing deeplinks to the dataLayer needs a newer WiseTrack SDK and was skipped.');
    return;
  }

  const dataLayerPush = createQueue('dataLayer');
  const eventName = data.deeplinkEventName || 'wisetrack_deeplink';
  callInWindow('WiseTrackSDK.WiseTrack.instance.setOnDeeplinkListener', function(uri, isDeferred) {
    dataLayerPush({
      event: eventName,
      wisetrack_deeplink: uri,
      wisetrack_deeplink_deferred: isDeferred === true
    });
  });
}

// Build the auto screen tracking config
function buildScreenTrackingConfig() {
  const screenConfig = {
    autoTrackScreens: data.autoTrackScreens !== false,
    autoTrackDialogs: data.autoTrackDialogs !== false
  };

  if (screenConfig.autoTrackScreens) {
    const excludedPaths = tableColumn(data.excludedScreenPaths, 'path');
    if (excludedPaths.length) screenConfig.excludedScreenPaths = excludedPaths;

    // Older SDKs call pattern.test() on every entry and would stop screen
    // tracking on string patterns, so only send them to an SDK that compiles them.
    const excludedPatterns = tableColumn(data.excludedScreenPatterns, 'pattern');
    if (excludedPatterns.length) {
      if (sdkSupportsTemplateFeatures()) {
        screenConfig.excludedScreenPatterns = excludedPatterns;
      } else {
        logToConsole('WiseTrack: Excluded Screen Patterns need a newer WiseTrack SDK and were ignored.');
      }
    }

    const sensitiveParams = tableColumn(data.sensitiveQueryParams, 'key');
    if (sensitiveParams.length) screenConfig.sensitiveQueryParams = sensitiveParams;

    if (data.deduplicationWindowMs) {
      screenConfig.deduplicationWindowMs = makeInteger(data.deduplicationWindowMs);
    }
  }

  return screenConfig;
}

// Initialize WiseTrack SDK
function initializeWiseTrack() {
  if(!isWiseTrackAvailable()) return;

  const config = {
    appToken: data.appToken,
    clientSecret: data.clientSecret,
    appVersion: data.appVersion,
    appFrameWork: data.appFramework,
    userEnvironment: data.userEnvironment,
    startTrackerAutomatically: data.autoStart !== false,
    logLevel: data.logLevel,
    trackingWaitingTime: data.trackingWaitingTime ? makeNumber(data.trackingWaitingTime) : 0,
    deeplinkEnabled: data.deeplinkEnabled !== false,
    screenTrackingConfig: buildScreenTrackingConfig()
  };

  if (data.defaultTracker) config.defaultTracker = data.defaultTracker;
  if (data.customDeviceId) config.customDeviceId = data.customDeviceId;

  // Registered before init: links received during initialization are held
  // by the SDK and delivered once a listener exists.
  registerDeeplinkListener();

  callInWindow('WiseTrackSDK.WiseTrack.instance.init', config);
  data.gtmOnSuccess();
}

// Track Event
function trackEvent() {
  if(!isWiseTrackAvailable()) return;

  // SDK 2.3.0 - 2.3.2 reject plain-object events, which is all a template can
  // send, so fail the tag instead of reporting success for a dropped event.
  if (!requireLatestSdk('Track Event')) return;

  const eventObject = {
    type: data.eventType,
    name: data.eventName,
    params: tableToParams(data.eventParameters)
  };

  if (data.eventType === 'revenue') {
    eventObject.amount = makeNumber(data.revenueAmount);
    eventObject.currency = data.currency;
  }

  callInWindow('WiseTrackSDK.WiseTrack.instance.trackEvent', eventObject);
  data.gtmOnSuccess();
}

// Track Screen
function trackScreen() {
  if(!isWiseTrackAvailable()) return;
  if (!requireLatestSdk('Track Screen')) return;

  const screen = {
    type: data.screenType || 'other',
    name: data.screenName,
    params: tableToParams(data.screenParameters)
  };
  if (data.screenDisplayName) screen.displayName = data.screenDisplayName;

  callInWindow('WiseTrackSDK.WiseTrack.instance.trackScreen', screen);
  data.gtmOnSuccess();
}

// Set Push Notification Token
function setPushToken() {
  if(!isWiseTrackAvailable()) return;
  if (!requireLatestSdk('Set Push Notification Token')) return;

  callInWindow('WiseTrackSDK.WiseTrack.instance.setFCMToken', data.pushToken);
  data.gtmOnSuccess();
}

// Set Log Level
function setLogLevel() {
  if(!isWiseTrackAvailable()) return;
  if (!requireLatestSdk('Set Log Level')) return;

  callInWindow('WiseTrackSDK.WiseTrack.instance.setLogLevel', data.runtimeLogLevel);
  data.gtmOnSuccess();
}

// Enable / Disable SDK. The SDK throws when it cannot be enabled (no config
// yet, or disabled from the panel), which fails the tag.
function setEnabled() {
  if(!isWiseTrackAvailable()) return;
  if (!requireLatestSdk('Enable / Disable SDK')) return;

  callInWindow('WiseTrackSDK.WiseTrack.instance.setEnabled', data.sdkEnabledState !== 'disable');
  data.gtmOnSuccess();
}

// Start Tracking
function startTracking(){
  if(!isWiseTrackAvailable()) return;

  callInWindow('WiseTrackSDK.WiseTrack.instance.startTracking');
  data.gtmOnSuccess();
}

// Stop Tracking
function stopTracking(){
  if(!isWiseTrackAvailable()) return;

  callInWindow('WiseTrackSDK.WiseTrack.instance.stopTracking');
  data.gtmOnSuccess();
}

// Flush SDK
function flushSdk(){
  if(!isWiseTrackAvailable()) return;

  callInWindow('WiseTrackSDK.WiseTrack.instance.flush');
  data.gtmOnSuccess();
}

// Inject SDK Script
function injectPackage(url, fallbackFunction) {
  logToConsole('SDK not found, injecting script...');

  injectScript(
    url,
    function() {
      logToConsole('Script loaded successfully');
      executeAction();
    },
    function() {
      if (fallbackFunction) {
        fallbackFunction();
      } else {
        logToConsole('Script loading failed');
        data.gtmOnFailure();
      }
    }
  );
}

// Execute action based on selection
function executeAction() {
  switch (action){
    case 'initialize':
      initializeWiseTrack();
    break;
    case 'track-event':
      trackEvent();
    break;
    case 'track-screen':
      trackScreen();
    break;
    case 'set-push-token':
      setPushToken();
    break;
    case 'set-log-level':
      setLogLevel();
    break;
    case 'set-enabled':
      setEnabled();
    break;
    case 'start-tracking':
      startTracking();
    break;
    case 'stop-tracking':
      stopTracking();
    break;
    case 'flush':
      flushSdk();
    break;
    default:
      logToConsole('Unknown WiseTrack action: ' + action);
      data.gtmOnFailure();
  }
}

// Main execution
const existingSDK = copyFromWindow('WiseTrackSDK');

if (action === 'initialize' && !existingSDK) {
  injectPackage(
    'https://unpkg.com/wisetrack/dist/cdn/sdk.bundle.min.js',
    function() {
      injectPackage(
        'https://cdn.jsdelivr.net/npm/wisetrack/dist/cdn/sdk.bundle.min.js',
        null
      );
    }
  );
} else if (existingSDK) {
  executeAction();
} else {
  logToConsole('SDK not loaded. Please initialize first.');
  data.gtmOnFailure();
}


